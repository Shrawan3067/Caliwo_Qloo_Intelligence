{
  "expo": {
    "name": "Caliwo",
    "slug": "caliwo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caliwo",
    "userInterfaceStyle": "light",
    "updates": {
      "url": "https://u.expo.dev/caliwo"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caliwo.ainutritioncoach",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap meals to auto-track calories & macros",
        "NSPhotoLibraryUsageDescription": "Choose meal photos to analyze nutrition",
        "NSMicrophoneUsageDescription": "Log meals with your voice",
        "NSMotionUsageDescription": "Read your steps to track daily activity",
        "NSHealthShareUsageDescription": "Read your steps, distance and active energy to power your daily activity insights",
        "NSHealthUpdateUsageDescription": "Caliwo only reads Apple Health data — it never writes to it"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.caliwo.ainutritioncoach",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withAndroidOptimizations",
      "./plugins/withWidgets",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose meal photos to analyze nutrition",
          "cameraPermission": "Snap meals to auto-track calories & macros"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Log meals with your voice"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan food barcodes to log packaged items"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
