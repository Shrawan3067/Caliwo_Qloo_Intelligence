# ─────────────────────────────────────────────────────────
# Caliwo Backend — Environment Variables
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ─── Database ───────────────────────────────────────────
# Neon Serverless Postgres (recommended) or self-hosted
DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST/caliwo?sslmode=require"

# Local Docker Postgres (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=caliwo

# ─── Security ──────────────────────────────────────────
# MUST be a cryptographically random string (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── AI Provider ──────────────────────────────────────
# Supported: openai, anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4o
COACH_MODEL=gpt-4o

# ─── External AI APIs ─────────────────────────────────
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ─── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development: http://localhost:8081,http://192.168.x.x:8081,caliwo://
# Production:  https://api.caliwo.app,caliwo://
ALLOWED_ORIGINS=http://localhost:8081,caliwo://
FRONTEND_BASE_URL=http://localhost:3000

# ─── Email (Password Reset) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@caliwo.app

# ─── RevenueCat & In-App Purchases ────────────────────
REVENUECAT_PUBLIC_ANDROID_KEY=goog_YOUR_ANDROID_KEY
REVENUECAT_PUBLIC_IOS_KEY=appl_YOUR_IOS_KEY
REVENUECAT_SECRET_KEY=sk_YOUR_REVENUECAT_SECRET_KEY

# ─── iOS App Store Server API ─────────────────────────
IOS_BUNDLE_ID=com.caliwo.ainutritioncoach
IOS_APPSTORE_ISSUER_ID=
IOS_APPSTORE_KEY_ID=
IOS_APPSTORE_PRIVATE_KEY=
IOS_APPSTORE_USE_SANDBOX=true

# ─── Android Google Play API ─────────────────────────
ANDROID_PACKAGE_NAME=com.caliwo.ainutritioncoach
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ─── Product IDs (must match store + RevenueCat) ─────
IAP_PRO_MONTHLY_PRODUCT_ID=com.caliwo.ainutritioncoach.pro_monthly

# ─── Webhook Secrets ─────────────────────────────────
WEBHOOK_SECRET=CHANGE_ME_RANDOM_STRING
APPLE_SHARED_SECRET=
APPLE_API_KEY=
APPLE_ISSUER_ID=

# ─── Qloo Cultural Intelligence ──────────────────────
# Required for taste personalization and cultural recommendations
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://hackathon.api.qloo.com
USE_QLOO_MOCK=false

# ─── Environment ─────────────────────────────────────
# Set to "production" for production deployments
ENVIRONMENT=development
